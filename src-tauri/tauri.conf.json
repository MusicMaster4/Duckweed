{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duckweed",
  "version": "0.1.0",
  "identifier": "dev.slop.duckweed",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duckweed",
        "width": 1280,
        "height": 820,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0f120f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjU3NjhGNkREQzZBQjEKUldTeGF0eHRqM1lsTDZ0NmVrSE84Y1kwdEhYOG96cmkzSlBHczdkRGRkZk1qcUJjR3pGVWVycGoK",
      "endpoints": [
        "https://github.com/MusicMaster4/Duckweed/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warp Clone",
  "version": "0.1.0",
  "identifier": "dev.slop.warpclone",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Warp Clone",
        "width": 1280,
        "height": 820,
        "minWidth": 620,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

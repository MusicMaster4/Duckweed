+// A closed data channel must not beat the final error. Missing close code 1009
+// makes Codex retry the same oversized history instead of falling back to SSE.
+func TestResponsesWebsocketPreservesErrorAfterDataClose(t *testing.T) {
+	for _, duplex := range []bool{false, true} {
+		for _, delayed := range []bool{false, true} {
+			for _, failure := range []struct {
+				name string
+				err  error
+				code int
+			}{
+				{"raw-too-big", &websocket.CloseError{Code: websocket.CloseMessageTooBig, Text: "history too big"}, websocket.CloseMessageTooBig},
+				{"mapped-too-big", websocketPinnedFailoverStatusError{status: http.StatusRequestEntityTooLarge, msg: `{"error":{"message":"history too big","code":"message_too_big"}}`}, websocket.CloseMessageTooBig},
+				{"http-replay", responsesWebsocketHTTPReplayRequiredError(), websocket.CloseServiceRestart},
+			} {
+				t.Run(fmt.Sprintf("%s/duplex=%t/delayed=%t", failure.name, duplex, delayed), func(t *testing.T) {
+					serverErr := make(chan error, 1)
+					server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+						conn, err := responsesWebsocketUpgrader.Upgrade(w, r, nil)
+						if err != nil {
+							serverErr <- err
+							return
+						}
+						defer conn.Close()
+						ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+						requestCtx, cancelRequest := context.WithTimeout(r.Context(), time.Second)
+						defer cancelRequest()
+						ctx.Request = r.WithContext(requestCtx)
+						data := make(chan []byte)
+						finalErrors := make(chan *interfaces.ErrorMessage, 1)
+						close(data)
+						publish := func() {
+							if delayed {
+								time.Sleep(10 * time.Millisecond)
+							}
+							finalErrors <- &interfaces.ErrorMessage{Error: failure.err}
+							close(finalErrors)
+						}
+						if delayed {
+							go publish()
+						} else {
+							publish()
+						}
+						h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, nil))
+						_, _, _, errMsg, errForward := h.forwardResponsesWebsocket(ctx, newResponsesWebsocketWriter(conn), func(...interface{}) {}, data, finalErrors, nil, "fallback", responsesWebsocketForwardOptions{duplexStream: func() bool { return duplex }})
+						if errMsg == nil || !errors.Is(errMsg.Error, failure.err) || !errors.Is(errForward, websocket.ErrCloseSent) {
+							serverErr <- fmt.Errorf("final error lost: message=%v forward=%v", errMsg, errForward)
+							return
+						}
+						serverErr <- nil
+					}))
+					defer server.Close()
+					conn, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer conn.Close()
+					conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+					_, _, err = conn.ReadMessage()
+					var closeErr *websocket.CloseError
+					if !errors.As(err, &closeErr) || closeErr.Code != failure.code {
+						t.Errorf("close=%v, want code %d", err, failure.code)
+					}
+					if err := <-serverErr; err != nil {
+						t.Error(err)
+					}
+				})
+			}
+		}
+	}
+}

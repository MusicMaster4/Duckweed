+func (h *OpenAIResponsesAPIHandler) responsesWebsocketNeedsHTTP(headers http.Header) bool {
+	if h == nil || h.AuthManager == nil {
+		return false
+	}
+	userAgent := strings.ToLower(strings.TrimSpace(headers.Get("User-Agent")))
+	if !util.IsCodexResponsesLiteRequest(nil, headers) && headers.Get("X-Codex-Turn-Metadata") == "" &&
+		!strings.HasPrefix(userAgent, "codex_") && !strings.HasPrefix(userAgent, "codex-") &&
+		!strings.HasPrefix(strings.ToLower(headers.Get("Originator")), "codex_") &&
+		!strings.HasPrefix(strings.ToLower(headers.Get("Originator")), "codex-") {
+		return false
+	}
+	foundCodex := false
+	for _, auth := range h.AuthManager.List() {
+		if auth == nil || !strings.EqualFold(auth.Provider, "codex") {
+			continue
+		}
+		foundCodex = true
+		if auth.Disabled || auth.Status == coreauth.StatusDisabled {
+			continue
+		}
+		if websocketUpstreamSupportsIncrementalInput(auth.Attributes, auth.Metadata) {
+			return false
+		}
+		// Absence of a setting is not an HTTP preference for OAuth accounts.
+		// API-key accounts explicitly default to HTTP in their provider config.
+		_, attributeSet := auth.Attributes["websockets"]
+		_, metadataSet := auth.Metadata["websockets"]
+		if !attributeSet && !metadataSet && auth.AuthKind() != coreauth.AuthKindAPIKey {
+			return false
+		}
+	}
+	return foundCodex
+}

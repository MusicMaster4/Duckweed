+func TestResponsesWebsocketTooBigFullDuplexIntegration(t *testing.T) {
+	for _, phase := range []string{"initial", "continuation"} {
+		t.Run(phase, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				c, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				defer c.Close()
+				c.SetReadDeadline(time.Now().Add(3 * time.Second))
+				if _, _, err = c.ReadMessage(); err != nil {
+					t.Error(err)
+					return
+				}
+				if phase == "continuation" {
+					if err = c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"r1"}}`)); err != nil {
+						t.Error(err)
+						return
+					}
+					if err = c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.completed","response":{"id":"r1","output":[]}}`)); err != nil {
+						t.Error(err)
+						return
+					}
+					if _, _, err = c.ReadMessage(); err != nil {
+						t.Error(err)
+						return
+					}
+				}
+				if err = c.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.CloseMessageTooBig, "history too big"), time.Now().Add(time.Second)); err != nil {
+					t.Error(err)
+				}
+			}))
+			defer upstream.Close()
+			cfg := &config.Config{}
+			cfg.Codex.ResponseSteering = true
+			cfg.CodexResponseSteering = true
+			manager := coreauth.NewManager(nil, nil, nil)
+			manager.SetConfig(cfg)
+			manager.RegisterExecutor(runtimeexecutor.NewCodexAutoExecutor(cfg))
+			authID := "fallback-" + phase
+			_, err := manager.Register(context.Background(), &coreauth.Auth{ID: authID, Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"api_key": "fixture", "base_url": upstream.URL, "websockets": "true"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			registry.GetGlobalRegistry().RegisterClient(authID, "codex", []*registry.ModelInfo{{ID: "fallback-model"}})
+			defer registry.GetGlobalRegistry().UnregisterClient(authID)
+			handler := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+			router := gin.New()
+			router.GET("/v1/responses", handler.ResponsesWebsocket)
+			server := httptest.NewServer(router)
+			defer server.Close()
+			c, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			c.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if err = c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.create","model":"fallback-model","input":[]}`)); err != nil {
+				t.Fatal(err)
+			}
+			for {
+				_, payload, err := c.ReadMessage()
+				if err != nil {
+					var closeErr *websocket.CloseError
+					if !errors.As(err, &closeErr) || closeErr.Code != websocket.CloseMessageTooBig {
+						t.Fatalf("close=%v, want code 1009", err)
+					}
+					break
+				}
+				if phase == "continuation" && gjson.GetBytes(payload, "type").String() == "response.completed" {
+					if err = c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.create","model":"fallback-model","previous_response_id":"r1","input":[]}`)); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			account, ok := manager.GetByID(authID)
+			if !ok || account.Disabled || account.Unavailable {
+				t.Fatal("message-size failure disabled the credential")
+			}
+		})
+	}
+}

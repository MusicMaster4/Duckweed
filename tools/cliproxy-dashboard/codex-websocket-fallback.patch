+func TestResponsesWebsocketNativeHTTPPolicyHandshake(t *testing.T) {
+	for _, native := range []bool{false, true} {
+		for _, enabled := range []bool{false, true} {
+			t.Run(fmt.Sprintf("native=%t/websockets=%t", native, enabled), func(t *testing.T) {
+				cfg := &config.Config{}
+				manager := coreauth.NewManager(nil, nil, nil)
+				_, err := manager.Register(context.Background(), &coreauth.Auth{ID: "http-policy", Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"websockets": fmt.Sprint(enabled)}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+				headers := http.Header{}
+				if native {
+					headers.Set("User-Agent", "codex_cli_rs/0.162.0")
+				} else {
+					headers.Set("User-Agent", "fixture-generic-client")
+				}
+				if actual := h.responsesWebsocketNeedsHTTP(headers); actual != (native && !enabled) {
+					t.Fatalf("forceHTTP=%t", actual)
+				}
+				if native && !enabled {
+					router := gin.New()
+					router.GET("/v1/responses", h.ResponsesWebsocket)
+					server := httptest.NewServer(router)
+					defer server.Close()
+					conn, response, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/v1/responses", headers)
+					if conn != nil {
+						conn.Close()
+					}
+					if response == nil || response.StatusCode != http.StatusUpgradeRequired || !errors.Is(err, websocket.ErrBadHandshake) {
+						t.Fatalf("HTTP fallback handshake=%v error=%v", response, err)
+					}
+					response.Body.Close()
+				}
+			})
+		}
+	}
+}

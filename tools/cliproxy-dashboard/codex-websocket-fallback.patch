+func TestResponsesWebsocketHTTPPolicyRecognizesAppServerMetadata(t *testing.T) {
+	cfg := &config.Config{}
+	manager := coreauth.NewManager(nil, nil, nil)
+	_, err := manager.Register(context.Background(), &coreauth.Auth{ID: "http-metadata", Provider: "codex", Status: coreauth.StatusActive, Attributes: map[string]string{"websockets": "false"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, manager))
+	headers := http.Header{"User-Agent": []string{"duckweed/0.1.0"}, "X-Codex-Turn-Metadata": []string{`{"request_kind":"prewarm"}`}}
+	if !h.responsesWebsocketNeedsHTTP(headers) {
+		t.Fatal("loaded Duckweed clients must receive the native HTTP fallback signal")
+	}
+	// Unspecified OAuth capabilities retain the existing downstream bridge.
+	unspecifiedManager := coreauth.NewManager(nil, nil, nil)
+	_, err = unspecifiedManager.Register(context.Background(), &coreauth.Auth{ID: "unspecified", Provider: "codex", Status: coreauth.StatusActive})
+	if err != nil {
+		t.Fatal(err)
+	}
+	unspecified := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, unspecifiedManager))
+	if unspecified.responsesWebsocketNeedsHTTP(headers) {
+		t.Fatal("missing setting treated as an HTTP preference")
+	}
+
+	// Another provider must not activate Codex's transport preference by itself.
+	otherManager := coreauth.NewManager(nil, nil, nil)
+	_, err = otherManager.Register(context.Background(), &coreauth.Auth{ID: "other", Provider: "claude", Status: coreauth.StatusActive})
+	if err != nil {
+		t.Fatal(err)
+	}
+	other := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&cfg.SDKConfig, otherManager))
+	if other.responsesWebsocketNeedsHTTP(headers) {
+		t.Fatal("Codex policy applied without a Codex account")
+	}

 // ResponsesWebsocket handles websocket requests for /v1/responses.
 // It accepts `response.create` and `response.append` requests and streams
 // response events back as JSON websocket text messages.
 func (h *OpenAIResponsesAPIHandler) ResponsesWebsocket(c *gin.Context) {
+	// Native Codex caches provider capabilities in loaded conversations. If all
+	// Codex accounts use HTTP, decline the upgrade with its supported fallback
+	// signal instead of accepting a socket that cannot forward native controls.
+	if h.responsesWebsocketNeedsHTTP(c.Request.Header) {
+		c.JSON(http.StatusUpgradeRequired, gin.H{"error": gin.H{"type": "invalid_request_error", "message": "Codex accounts use HTTP streaming"}})
+		return
+	}
 	conn, err := responsesWebsocketUpgrader.Upgrade(c.Writer, c.Request, websocketUpgradeHeaders(c.Request))
 	if err != nil {
 		return

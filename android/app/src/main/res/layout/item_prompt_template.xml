<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" android:background="@drawable/message_card"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/prompt_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
        android:textColor="@color/duckweed_text" android:textSize="16sp" />
    <TextView android:id="@+id/prompt_preview" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:maxLines="4" android:ellipsize="end" android:textColor="@color/duckweed_text_dim" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginTop="12dp">
        <Button android:id="@+id/prompt_view" android:layout_width="wrap_content" android:layout_height="48dp"
            android:background="@drawable/button_secondary" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="View" android:textAllCaps="false" android:textColor="@color/duckweed_text" />
        <Button android:id="@+id/prompt_copy" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="10dp" android:background="@drawable/button_primary"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Copy prompt"
            android:textAllCaps="false" android:textColor="@color/duckweed_accent_ink" />
    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/message_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/message_agent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/duckweed_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/message_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/duckweed_text_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/message_project"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/duckweed_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/message_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:maxLines="6"
        android:textColor="@color/duckweed_text_dim"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/message_expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Show full response"
        android:textColor="@color/duckweed_accent"
        android:textSize="11sp" />
</LinearLayout>

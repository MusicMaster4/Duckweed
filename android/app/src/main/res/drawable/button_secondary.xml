<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#29302A" />
            <stroke android:width="1dp" android:color="#526052" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#171C18" />
            <stroke android:width="1dp" android:color="#303A31" />
        </shape>
    </item>
</selector>
